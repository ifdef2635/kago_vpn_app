<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup and no device-to-device transfer of app data.
     The profile (proxy passwords, controller secret), preferences and the
     WebView cookies of the usekago.net session stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
